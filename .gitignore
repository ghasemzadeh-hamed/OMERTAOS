# Share only the safe, reviewable Codex contract. Legacy local skills,
# one-off repair scripts, backups, caches, logs, and storage stay local.
!.codex/
.codex/*
!.codex/AGENTS.md
!.codex/CHANGELOG.md
!.codex/CONTEXT.md
!.codex/RULES.md
!.codex/SECURITY.md
