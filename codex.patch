-
-    drift_raw = metrics.get("drift", {}).get("train_val_psi", 0.0)
-    try:
-        drift_value = float(drift_raw)
-    except (TypeError, ValueError):
-        drift_value = 0.0
-    if math.isnan(drift_value):
-        drift_value = 0.0
