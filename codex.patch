-import time, heapq
-class Scheduler:
-pq = [] # (priority, ts, task)
-@classmethod
-def submit(cls, task, tenant):
-item = (task["priority"], time.time(), task)
-heapq.heappush(cls.pq, item)
-return {"enqueued": True, "size": len(cls.pq)}
-@classmethod
-def next(cls):
-if not cls.pq: return None
-return heapq.heappop(cls.pq)[2]
