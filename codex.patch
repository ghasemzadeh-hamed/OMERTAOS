-    ".pyi",
-    ".ts",
-    ".tsx",
-    ".js",
-    ".jsx",
-    ".json",
-    ".yaml",
-    ".yml",
-    ".sql",
-    ".sh",
-    ".ps1",
-    ".toml",
-    ".ini",
-    ".cfg",
-    ".conf",
-}
-
-
-def _format_replacement(codepoint: int, path: pathlib.Path) -> str:
