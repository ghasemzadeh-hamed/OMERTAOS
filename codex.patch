-            "state": "proposed",
-            "profile": profile_name,
-            "router": profile_cfg.get("features", {}).get("router", {}),
-        }
-        _STATE["pending"] = item
-        return {"ok": True, "pending": item}
-
-
-@router.post("/apply")
-async def apply(request: Request) -> Dict[str, Any]:
-    _require_admin(request)
-    async with _LOCK:
-        if not _STATE["pending"]:
