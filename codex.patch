-    await runCommand('apt-get', ['install', '-y', ...packages]);
-  } catch (error) {
-    if (!optional) {
-      throw error;
-    }
-    appendLog(`warn apt-get install ${packages.join(' ')}: ${(error as Error).message}`);
-  }
