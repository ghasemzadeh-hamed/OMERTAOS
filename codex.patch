-    top = []
-    for node in graph:
-        top.append(
-            {
-                "module": node,
-                "fan_in": indeg[node],
-                "fan_out": outdeg[node],
-                "centrality": indeg[node] + outdeg[node],
-            }
-        )
-    top.sort(key=lambda x: x["centrality"], reverse=True)
