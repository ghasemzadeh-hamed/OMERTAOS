-def strongly_connected_components(graph: dict[str, set[str]]) -> list[list[str]]:
-    index = 0
-    idx: dict[str, int] = {}
-    low: dict[str, int] = {}
-    stack: list[str] = []
-    on_stack: set[str] = set()
-    out: list[list[str]] = []
-
-    def visit(v: str) -> None:
-        nonlocal index
-        idx[v] = index
-        low[v] = index
-        index += 1
-        stack.append(v)
-        on_stack.add(v)
-
-        for w in graph.get(v, set()):
-            if w not in idx:
-                visit(w)
-                low[v] = min(low[v], low[w])
-            elif w in on_stack:
-                low[v] = min(low[v], idx[w])
-
-        if low[v] == idx[v]:
-            comp: list[str] = []
-            while True:
-                w = stack.pop()
-                on_stack.remove(w)
-                comp.append(w)
-                if w == v:
-                    break
-            if len(comp) > 1:
-                out.append(sorted(comp))
-
-    for n in graph:
-        if n not in idx:
-            visit(n)
-    return out
