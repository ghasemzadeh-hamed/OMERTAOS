-    quantile_edges = np.quantile(expected_arr, np.linspace(0.0, 1.0, bins + 1))
-    breakpoints = np.unique(quantile_edges)
-
-    if breakpoints.size < 2:
-        width = max(abs(expected_arr[0]), 1.0)
