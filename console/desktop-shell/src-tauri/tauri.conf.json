{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMERTAOS Desktop",
  "version": "0.1.0",
  "identifier": "io.omertaos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:3000 http://localhost:8080; frame-src http://localhost:3000"
    },
    "windows": [
      {
        "label": "main",
        "title": "OMERTAOS",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
