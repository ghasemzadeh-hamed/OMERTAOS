[Unit]
Description=OMERTAOS Control plane
Requires=omertaos-runtime.service postgresql.service redis-server.service
After=network-online.target omertaos-runtime.service postgresql.service redis-server.service
Wants=network-online.target
PartOf=omertaos.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=omertaos
Group=omertaos
EnvironmentFile=/etc/omertaos/omertaos.env
WorkingDirectory=/opt/omertaos/OMERTAOS
ExecStart=/var/lib/omertaos/venvs/control/bin/python -m uvicorn control.app.main:app --host ${CONTROL_HOST} --port ${AION_CONTROL_HTTP_PORT}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=omertaos.target
