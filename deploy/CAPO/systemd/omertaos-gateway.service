[Unit]
Description=OMERTAOS Gateway
Requires=omertaos-control.service
After=network-online.target omertaos-control.service
Wants=network-online.target
PartOf=omertaos.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=omertaos
Group=omertaos
EnvironmentFile=/etc/omertaos/omertaos.env
WorkingDirectory=/opt/omertaos/OMERTAOS/gateway
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=omertaos.target
