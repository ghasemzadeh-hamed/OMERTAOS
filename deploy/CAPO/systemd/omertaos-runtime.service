[Unit]
Description=OMERTAOS Runtime daemon
After=network-online.target
Wants=network-online.target
PartOf=omertaos.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=omertaos
Group=omertaos
EnvironmentFile=/etc/omertaos/omertaos.env
WorkingDirectory=/opt/omertaos/OMERTAOS/runtime-daemon
ExecStart=/var/lib/omertaos/bin/runtime-daemon
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=omertaos.target
