# Install as /etc/omertaos/gateway.env (0640 root:omertaos).
AION_GATEWAY_HOST=0.0.0.0
AION_GATEWAY_PORT=8080
AION_CONTROL_BASE_URL=http://127.0.0.1:8000
# gRPC endpoints are host:port values; do not add an http:// scheme.
AION_CONTROL_GRPC=127.0.0.1:50051
AION_REDIS_URL=redis://127.0.0.1:6379/1
AION_CONSOLE_ORIGIN=http://127.0.0.1:3000
AION_PROFILE=user
AION_ENV=production
AION_GATEWAY_ADMIN_TOKEN=CHANGE_ME
SECRET_PROVIDER_MODE=local
