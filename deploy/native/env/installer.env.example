# Installer-only values: install as /etc/omertaos/installer.env (0600 root:root).
# No long-running service may load this file.
OMERTAOS_POSTGRES_ROLE=omertaos
OMERTAOS_POSTGRES_DATABASE=omertaos
OMERTAOS_POSTGRES_PASSWORD=CHANGE_ME
OMERTAOS_CONSOLE_POSTGRES_ROLE=omertaos_console
OMERTAOS_CONSOLE_POSTGRES_DATABASE=omertaos_console
OMERTAOS_CONSOLE_POSTGRES_PASSWORD=CHANGE_ME
OMERTAOS_CONSOLE_ADMIN_EMAIL=CHANGE_ME
OMERTAOS_CONSOLE_ADMIN_PASSWORD=CHANGE_ME
OMERTAOS_CONSOLE_ADMIN_PASSWORD_MIN_LENGTH=8
OMERTAOS_CONSOLE_ADMIN_PASSWORD_MAX_LENGTH=32
OMERTAOS_CONSOLE_ADMIN_NAME=OMERTAOS Administrator
