[Unit]
Description=OMERTAOS Console
Requires=omertaos-gateway.service
After=network-online.target omertaos-gateway.service
Wants=network-online.target
PartOf=omertaos.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=omertaos
Group=omertaos
EnvironmentFile=/etc/omertaos/omertaos.env
EnvironmentFile=/etc/omertaos/console.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/omertaos/current/console
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start
ExecStartPre=/usr/bin/test -f /opt/omertaos/current/console/.next/BUILD_ID
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=omertaos.target
