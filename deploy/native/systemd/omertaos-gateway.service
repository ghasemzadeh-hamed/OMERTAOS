[Unit]
Description=OMERTAOS Gateway
Requires=omertaos-control.service
After=network-online.target omertaos-control.service
Wants=network-online.target
PartOf=omertaos.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=omertaos
Group=omertaos
EnvironmentFile=/etc/omertaos/omertaos.env
EnvironmentFile=/etc/omertaos/gateway.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/omertaos/current/gateway
ExecStart=/usr/bin/node dist/server.js
ExecStartPre=/usr/bin/test -f /opt/omertaos/current/gateway/dist/server.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=omertaos.target
